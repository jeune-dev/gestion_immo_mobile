# Copier en android/key.properties (jamais versionné) pour signer les builds de release.
# Créer la clé une seule fois :
#   keytool -genkey -v -keystore ~/gestion-immo-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
storePassword=
keyPassword=
keyAlias=upload
storeFile=/Users/<vous>/gestion-immo-upload.jks
