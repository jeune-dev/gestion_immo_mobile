<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Développement : l'API locale est en HTTP (http://10.0.2.2:3000 depuis
         l'émulateur). La production utilise HTTPS.

         `tools:replace` est désormais nécessaire : le manifeste principal
         déclare explicitement `usesCleartextTraffic="false"`, et sans cette
         mention la fusion des deux échouerait sur l'attribut contradictoire.
         La dérogation vaut ICI et nulle part ailleurs — une version publiée
         ne l'emporte jamais. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
