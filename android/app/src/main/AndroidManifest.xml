<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Android 13 (API 33) et au-delà : afficher une notification demande une
         autorisation de l'utilisateur, et cette autorisation ne peut même pas
         être DEMANDÉE si la permission n'est pas déclarée ici.
         `PushService.requestPermission()` revenait donc refusée sans le moindre
         message, sur tout téléphone récent. Le défaut ne se voyait pas tant que
         les fichiers Firebase manquaient ; il se verrait maintenant. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Trafic en clair REFUSÉ, explicitement.
         Android 9 (API 28) et au-delà le refusent par défaut, mais `minSdk`
         vaut 24 : sur Android 7.0 et 8.x, encore répandus ici, la valeur par
         défaut est l'inverse et une requête HTTP serait acceptée. `Env` la
         refuse déjà côté Dart en version publiée ; cette ligne ferme la même
         porte au niveau du système, pour les appareils où elle était ouverte.
         Les builds de développement la rouvrent pour eux seuls, voir
         src/debug/AndroidManifest.xml. -->
    <application
        android:label="Kërimmo"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
