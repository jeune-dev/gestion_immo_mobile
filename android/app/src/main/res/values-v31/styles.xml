<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de démarrage, Android 12 (API 31) et au-delà.
     À partir de cette version, le système dessine LUI-MÊME l'écran de
     démarrage et ignore `android:windowBackground` : les `launch_image.png`
     de `launch_background.xml` ne s'affichent plus. Sans ce fichier, le fond
     du démarrage devenait celui du thème système — donc différent du blanc
     que voient les appareils en Android 7 à 11 (minSdk vaut 24).
     L'icône reste celle du lanceur, dessinée par le système à la bonne
     taille : la fournir à la main revient à refaire moins bien. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/fond_demarrage</item>
        <!-- Toujours utile en Android 12+ : passé l'écran de démarrage du
             système, c'est ce fond que la fenêtre affiche jusqu'à la première
             image de Flutter. Sans lui, celui du thème parent apparaît — blanc
             cassé en thème clair, NOIR en thème sombre, soit un clignotement
             entre le démarrage blanc et l'application. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
