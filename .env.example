# ============================================================================
#  Gestion Immo — configuration de l'application mobile (développement)
#  Fichier lu au démarrage (flutter_dotenv). JAMAIS de secret ici : il est
#  embarqué dans l'application.
# ============================================================================

# URL de l'API (backend gestion_immo_back, préfixe /api/v1).
#  - Simulateur iOS / émulateur Android : localhost (sur Android, l'app
#    remplace automatiquement localhost par 10.0.2.2, l'adresse de ce Mac) ;
#  - Téléphone réel sur le même Wi-Fi : l'adresse IP du Mac, ex.
#    API_URL=http://192.168.1.11:5010/api/v1 (et lancer l'API avec HOST=0.0.0.0).
API_URL=http://localhost:5010/api/v1
